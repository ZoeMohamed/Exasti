# Takar - Environment Variables

# 1. Database PostgreSQL 15+ (Supabase / Neon / Local)
# Skema: db/schema.sql
DATABASE_URL="postgresql://postgres:password@localhost:5432/takar"

# 2. Google AI Studio (Gemini Flash)
# Ambil gratis tanpa kartu kredit di: https://aistudio.google.com
GEMINI_API_KEY=""

# 3. Mode Penggunaan
NEXT_PUBLIC_APP_ENV="development"
